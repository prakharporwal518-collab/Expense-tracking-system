# Copy to .env and adjust. All values have safe development defaults.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# REQUIRED in production (>=16 chars). Auto-generated for development.
# JWT_SECRET=change-me-to-a-long-random-string
DB_FILE=./data/fintrack.db
DEFAULT_CURRENCY=INR
TOKEN_TTL_SECONDS=604800
RATE_WINDOW_MS=60000
RATE_MAX=300
RATE_AUTH_MAX=20
LOG_LEVEL=debug

# --- Persistence -------------------------------------------------------
# Set DATABASE_URL to use Postgres (recommended for deployment; data survives
# restarts). Leave it unset to use SQLite at DB_FILE, which needs no setup but
# is wiped on hosts with ephemeral storage.
# DATABASE_URL=postgresql://user:pass@host:5432/fintrack
# DATABASE_SSL=true

# --- Email (password reset) --------------------------------------------
# Without a key the reset link is written to the logs, and returned in the
# response outside production, so recovery still works.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=FinTrack <noreply@yourdomain.com>
# APP_URL=https://your-app.onrender.com

# --- Demo data ----------------------------------------------------------
# Seeds the demo account on boot, but only into a database with no accounts.
# SEED_DEMO=true
